# Copy to .env and adjust. Every app setting uses the OMNIRAG_ prefix.

# --- App
OMNIRAG_ENV=dev
OMNIRAG_LOG_LEVEL=INFO
OMNIRAG_LOG_JSON=true

# --- Neo4j (docker-compose reads NEO4J_PASSWORD too)
OMNIRAG_NEO4J_URI=bolt://localhost:7687
OMNIRAG_NEO4J_USER=neo4j
OMNIRAG_NEO4J_PASSWORD=change-me-please
OMNIRAG_NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=change-me-please

# --- Ollama (native on Windows; reachable as localhost from WSL in mirrored networking mode)
OMNIRAG_OLLAMA_BASE_URL=http://localhost:11434
OMNIRAG_OLLAMA_TIMEOUT_S=120
OMNIRAG_GENERATION_MODEL=qwen3:4b-instruct
OMNIRAG_EMBEDDING_MODEL=bge-m3

# --- Ingestion (keep data on the WSL ext4 disk, not on /mnt/*)
OMNIRAG_DATA_DIR=/home/gautam/omnirag-data
OMNIRAG_MAX_UPLOAD_MB=100

# --- OCR (needs: sudo apt install tesseract-ocr; extra languages: tesseract-ocr-deu etc.)
OMNIRAG_OCR_ENABLED=true
OMNIRAG_OCR_LANGUAGES=eng
OMNIRAG_OCR_DPI=300
OMNIRAG_OCR_MAX_PAGES=50

# --- PDF engine: auto (multi-column -> Docling, else PyMuPDF) | pymupdf | docling
OMNIRAG_PDF_ENGINE=auto

# --- image descriptions (needs: ollama pull qwen3-vl:2b-instruct)
OMNIRAG_VISION_ENABLED=true
OMNIRAG_VISION_MODEL=qwen3-vl:2b-instruct
OMNIRAG_VISION_MAX_IMAGES=20

# --- background ingestion (API)
OMNIRAG_INGESTION_WORKERS=1
OMNIRAG_INGESTION_QUEUE_MAX=100
OMNIRAG_INGESTION_SHUTDOWN_GRACE_S=30

# --- chunking (Phase 3): sizes in bge-m3 tokens; strategies as a JSON list
OMNIRAG_CHUNKING_ENABLED=true
OMNIRAG_CHUNK_SIZE=512
OMNIRAG_CHUNK_OVERLAP=64
OMNIRAG_CHUNK_CHILD_SIZE=128
OMNIRAG_CHUNK_PARENT_SIZE=2048
OMNIRAG_CHUNK_CONTEXTUAL_HEADERS=false
# OMNIRAG_CHUNKING_STRATEGIES=["structure","table","multimodal"]
# Semantic chunking calls Ollama (bge-m3) during ingestion, so it is opt-in:
# OMNIRAG_CHUNKING_STRATEGIES=["structure","table","multimodal","semantic"]
