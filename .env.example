# Copy to .env and adjust. Every app setting uses the OMNIRAG_ prefix.

# --- App
OMNIRAG_ENV=dev
OMNIRAG_LOG_LEVEL=INFO
OMNIRAG_LOG_JSON=true

# --- Neo4j (docker-compose reads NEO4J_PASSWORD too)
OMNIRAG_NEO4J_URI=bolt://localhost:7687
OMNIRAG_NEO4J_USER=neo4j
OMNIRAG_NEO4J_PASSWORD=change-me-please
OMNIRAG_NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=change-me-please

# --- Ollama (native on Windows; reachable as localhost from WSL in mirrored networking mode)
OMNIRAG_OLLAMA_BASE_URL=http://localhost:11434
OMNIRAG_OLLAMA_TIMEOUT_S=120
OMNIRAG_GENERATION_MODEL=qwen3:4b-instruct
OMNIRAG_EMBEDDING_MODEL=bge-m3

# --- Ingestion (keep data on the WSL ext4 disk, not on /mnt/*)
OMNIRAG_DATA_DIR=/home/gautam/omnirag-data
OMNIRAG_MAX_UPLOAD_MB=100

# --- OCR (needs: sudo apt install tesseract-ocr; extra languages: tesseract-ocr-deu etc.)
OMNIRAG_OCR_ENABLED=true
OMNIRAG_OCR_LANGUAGES=eng
OMNIRAG_OCR_DPI=300
OMNIRAG_OCR_MAX_PAGES=50

# --- PDF engine: auto (multi-column -> Docling, else PyMuPDF) | pymupdf | docling
OMNIRAG_PDF_ENGINE=auto

# --- image descriptions (needs: ollama pull qwen3-vl:2b-instruct)
OMNIRAG_VISION_ENABLED=true
OMNIRAG_VISION_MODEL=qwen3-vl:2b-instruct
OMNIRAG_VISION_MAX_IMAGES=20

# --- background ingestion (API)
OMNIRAG_INGESTION_WORKERS=1
OMNIRAG_INGESTION_QUEUE_MAX=100
OMNIRAG_INGESTION_SHUTDOWN_GRACE_S=30

# --- chunking (Phase 3): sizes in bge-m3 tokens; strategies as a JSON list
OMNIRAG_CHUNKING_ENABLED=true
OMNIRAG_CHUNK_SIZE=256
OMNIRAG_CHUNK_OVERLAP=32
OMNIRAG_CHUNK_CHILD_SIZE=128
OMNIRAG_CHUNK_PARENT_SIZE=2000
OMNIRAG_CHUNK_CONTEXTUAL_HEADERS=true
# OMNIRAG_CHUNKING_STRATEGIES=["structure","table","multimodal"]
# Semantic chunking calls Ollama (bge-m3) during ingestion, so it is opt-in:
# OMNIRAG_CHUNKING_STRATEGIES=["structure","table","multimodal","semantic"]

# --- embeddings (Phase 4): which chunk sets are embedded at ingestion, and how
OMNIRAG_EMBEDDING_ENABLED=true
OMNIRAG_EMBEDDING_INDEX_CONFIGS=["multimodal-256-ctx"]
OMNIRAG_EMBEDDING_DIM=1024
# Measured limit incl. 2 special tokens (Ollama 0.40.14 + bge-m3): 2048, not 8192
OMNIRAG_EMBEDDING_MAX_TOKENS=2048
OMNIRAG_EMBEDDING_BATCH_SIZE=32

# --- knowledge graph (Phase 5, ADR-0011)
OMNIRAG_GRAPH_ENABLED=true
# Chunk sets stored as Chunk nodes; empty list = the embedded sets above
OMNIRAG_GRAPH_CHUNK_CONFIGS=[]
OMNIRAG_GRAPH_VECTOR_INDEX=chunk_embedding
OMNIRAG_GRAPH_VECTOR_QUANTIZATION=NONE
OMNIRAG_GRAPH_FULLTEXT_INDEX=chunk_fulltext
OMNIRAG_GRAPH_FULLTEXT_ANALYZER=classic

# --- entity/relation extraction (Phase 5b, ADR-0012); ~15 s/chunk, so off at ingestion
OMNIRAG_EXTRACTION_ENABLED=false
OMNIRAG_EXTRACTION_MODEL=qwen3:4b-instruct
# chunk set to extract from; empty = the first graph chunk set
OMNIRAG_EXTRACTION_CONFIG=
OMNIRAG_EXTRACTION_TIMEOUT_S=300
OMNIRAG_EXTRACTION_NUM_CTX=8192

# --- retrieval (Phase 6, ADR-0013)
# chunk set to search; empty = the first graph chunk set
OMNIRAG_RETRIEVAL_CONFIG=
OMNIRAG_RETRIEVAL_K=5
# post-filters fetch k x overfetch candidates (at most max_fetch)
OMNIRAG_RETRIEVAL_OVERFETCH=10
OMNIRAG_RETRIEVAL_MAX_FETCH=200
# technical identifiers (AUR-C103) in BM25 queries: terms | boost | require
OMNIRAG_RETRIEVAL_IDENTIFIER_MODE=require

# --- graph retrieval + fusion (Phase 7, ADR-0014)
OMNIRAG_RETRIEVAL_DEFAULT_MODE=dense+bm25
OMNIRAG_RETRIEVAL_GRAPH_MAX_HOPS=2
OMNIRAG_RETRIEVAL_RRF_K=60
OMNIRAG_RETRIEVAL_FUSION_DEPTH=20
# per-retriever RRF weights (JSON), e.g. {"graph": 0.5}
OMNIRAG_RETRIEVAL_RRF_WEIGHTS={}

# --- cross-encoder reranking (Phase 8, ADR-0015); weights (2.27 GB) download on first use
OMNIRAG_RERANK_ENABLED=true
OMNIRAG_RERANK_MODEL=bge-reranker-v2-m3
# auto: CUDA if a CUDA torch is installed, else CPU
OMNIRAG_RERANK_DEVICE=auto
# candidates re-scored per query (CPU: depth 20 ~17 s, depth 10 ~9.5 s)
OMNIRAG_RERANK_DEPTH=20
OMNIRAG_RERANK_MAX_LENGTH=512
OMNIRAG_RERANK_BATCH_SIZE=4
OMNIRAG_RERANK_THREADS=8

# --- corrective retrieval workflow (Phase 9a, ADR-0016): defaults for /retrieval/advanced
# none | rewrite | multi_query | hyde | multi_query+hyde (none: no transform helped here)
OMNIRAG_WORKFLOW_TRANSFORM=none
OMNIRAG_WORKFLOW_MULTI_QUERY_N=3
OMNIRAG_WORKFLOW_GRADE=true
OMNIRAG_WORKFLOW_MAX_RETRIES=1
OMNIRAG_WORKFLOW_RERANK=false
OMNIRAG_WORKFLOW_LLM_TIMEOUT_S=60
# Phase 9b (ADR-0017): router (off | rules | llm), self-query (off | soft | hard),
# agent (off | auto = multi-hop questions only | always), per-document cap (empty = none)
OMNIRAG_WORKFLOW_ROUTE=rules
OMNIRAG_WORKFLOW_SELF_QUERY=off
OMNIRAG_WORKFLOW_AGENT=auto
OMNIRAG_WORKFLOW_AGENT_STEPS=2
# OMNIRAG_WORKFLOW_MAX_PER_DOCUMENT=2

# --- context assembly (Phase 9c, ADR-0018): the context handed to the generator
# budget in bge-m3 tokens (incl. block headers); expand: none | neighbors | section;
# compress (extractive): none | lexical | embedding | llm. Defaults measured best on both sets.
OMNIRAG_CONTEXT_BUDGET_TOKENS=1024
OMNIRAG_CONTEXT_EXPAND=none
OMNIRAG_CONTEXT_COMPRESS=none

# --- generation (Phases 10-11, ADR-0019): grounded answers with checked citations
OMNIRAG_GENERATION_NUM_PREDICT=1024
OMNIRAG_GENERATION_TIMEOUT_S=180
# refuse without a model call when no passage names the question's identifiers
OMNIRAG_GENERATION_RESPECT_CHECK=true
# chat history + query traces (SQLite); default <data_dir>/omnirag.db
# OMNIRAG_CHAT_DB_PATH=/home/you/omnirag-data/omnirag.db

# --- LangSmith (Phase 12, ADR-0020): external hosted service, so off by default.
# Tracing needs both the flag and LANGSMITH_API_KEY (read by the langsmith SDK itself);
# REDACT=true hides inputs/outputs (document text) in traces.
OMNIRAG_LANGSMITH_TRACING=false
OMNIRAG_LANGSMITH_PROJECT=omnirag
OMNIRAG_LANGSMITH_REDACT=true
# LANGSMITH_API_KEY=lsv2_...   (never commit it)
# measured evaluation reports shown by /analytics and /evaluate (default: the repo's docs/benchmarks)
# OMNIRAG_BENCHMARKS_DIR=/app/docs/benchmarks

# --- Docker deployment (Phase 15, ADR-0021): host data directory mounted at /data
# OMNIRAG_HOST_DATA_DIR=/home/you/omnirag-data

# --- dashboard (Streamlit): the API it talks to
OMNIRAG_FRONTEND_API_URL=http://localhost:8000
OMNIRAG_FRONTEND_TIMEOUT_S=180
